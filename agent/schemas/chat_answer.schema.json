{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.local/schemas/chat_answer.schema.json",
  "title": "ChatAnswer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "insight_id",
    "question",
    "answer",
    "sources",
    "confidence",
    "trace_id",
    "gaps"
  ],
  "properties": {
    "insight_id": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "answer": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "trace_id": { "type": "string", "minLength": 1 },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "origin", "source_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["ai", "bank"] },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "title", "url", "published_at"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["news", "bank_analytics", "client_profile"] },
        "title": { "type": "string", "minLength": 1 },
        "url": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "published_at": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    }
  }
}
